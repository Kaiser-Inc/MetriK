# ──────────────────────────────────────────────
# MetriK — variáveis de ambiente
# Copiar para .env.local e preencher
# ──────────────────────────────────────────────

# Modo local: caminho absoluto para a pasta metrics/ do projeto alvo
# Se esta variável estiver ausente → modo deploy (FilePicker no browser)
METRICS_DIR=/caminho/absoluto/para/pasta/metrics

# ──────────────────────────────────────────────
# Docker (modo local em container)
# ──────────────────────────────────────────────
# Caminho absoluto NO HOST para a pasta metrics/ do projeto alvo.
# O docker-compose monta este caminho em /metrics:ro e define
# METRICS_DIR=/metrics dentro do container.
#   METRICS_HOST_DIR=/abs/path/para/metrics docker compose up --build
METRICS_HOST_DIR=/caminho/absoluto/no/host/para/metrics

# Porta exposta no host (opcional, padrão 3000)
# METRIK_PORT=3000
